    {
      "id": "video.profile",
      "scope": "video",
      "category": "画质",
      "title": "编码档次 Profile",
      "subtitle": "H.264/H.265 的兼容性等级",
      "icon": "gauge",
      "level": "advanced",
      "doc": "Profile 决定目标设备能不能播。baseline 兼容最老设备但没有 B 帧；main 适合移动端；high 是桌面和高清标准。注意：high/main/baseline 都只支持 8-bit 4:2:0，所以这个模块会同时把像素格式钉成 yuv420p——源素材如果是 4:4:4，不加这一步编码器会直接报错。",
      "controls": [
        {
          "key": "profile",
          "type": "enum",
          "label": "Profile",
          "default": "high",
          "options": [
            {
              "value": "baseline",
              "label": "baseline · 最老设备"
            },
            {
              "value": "main",
              "label": "main · 移动端"
            },
            {
              "value": "high",
              "label": "high · 标准高清"
            }
          ]
        }
      ],
      "summary": "{profile}",
      "bindings": [
        {
          "when": {
            "encoder": [
              "libx264",
              "libx265"
            ]
          },
          "emit": [
            "-profile:v",
            "{profile}",
            "-pix_fmt",
            "yuv420p"
          ]
        }
      ]
    },
