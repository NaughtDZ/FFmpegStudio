<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FfmpegStudio"
        mc:Ignorable="d"
        Title="FFmpeg Studio"
        Width="1200" Height="880"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C10"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#151B25" Offset="0"/>
            <GradientStop Color="#11161E" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8EDF6"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#5D6B82"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ValuePill" TargetType="Border">
            <Setter Property="Background" Value="#0D1219"/>
            <Setter Property="BorderBrush" Value="#28303F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>



        <!-- ===== 细进度条 ===== -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#1B2330" CornerRadius="2" Height="3">
                            <Grid>
                                <Border x:Name="PART_Track" Background="Transparent"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="#38BDF8" CornerRadius="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主按钮 ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Padding="14,5"
                                Background="#2F5CE0" BorderBrush="#3F74FF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3F74FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 任务条目 ===== -->
        <DataTemplate x:Key="JobTemplate" DataType="{x:Type local:JobVm}">
            <Border x:Name="jobCard" Background="#121720" CornerRadius="7" Padding="9,7" Margin="0,0,0,5"
                    Cursor="Hand" MouseLeftButtonUp="Job_Click">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="#E8EDF6"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="st" Text="{Binding StatusText}" DockPanel.Dock="Right"
                                   FontSize="9.5" Foreground="#5D6B82" Margin="6,0,0,0"/>
                    </DockPanel>
                    <TextBlock Text="{Binding MediaText}" FontSize="9.5" Foreground="#5D6B82" Margin="0,1,0,0"/>
                    <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent}"
                                 Maximum="100" Margin="0,5,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="9" Foreground="#7D8DA6" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="jobCard" Property="Background" Value="#16283F"/>
                    <Setter TargetName="jobCard" Property="BorderBrush" Value="#2C4470"/>
                    <Setter TargetName="jobCard" Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="st" Property="Foreground" Value="#34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="st" Property="Foreground" Value="#F87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="st" Property="Foreground" Value="#8FB6FF"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== 媒体流开关 ===== -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="30" Height="17" CornerRadius="9" Background="#2A3346">
                                <Ellipse x:Name="knob" Width="13" Height="13" Fill="#8E9BB3"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#2E4A7A"/>
                                <Setter TargetName="knob" Property="Fill" Value="#7BA0FF"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===== 卡片上的迷你操作按钮（替代拖拽） ===== -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4D5A70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#233045"/>
                                <Setter Property="Foreground" Value="#8FB6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 链上卡片 ===== -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:ModuleCardVm}">
            <Border x:Name="Card" MinHeight="52" Margin="0,0,0,6" CornerRadius="10" BorderThickness="1"
                    Background="{StaticResource CardBg}" BorderBrush="#1D2431"
                    Cursor="Hand" MouseLeftButtonUp="Card_Click">
                <Grid>
                    <Border x:Name="Accent" Width="2.5" HorizontalAlignment="Left" Background="#22D3EE">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <Grid Margin="14,7,11,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                Background="#1B2331" VerticalAlignment="Center">
                            <Path Data="{Binding IconGeometry}" Stroke="#7FDCED" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Title}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StateTag" Visibility="Collapsed" CornerRadius="4"
                                    Padding="5,1" Margin="0,0,6,0" Background="#33290F">
                                <TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontSize="9.5" Foreground="#FBBF24"/>
                            </Border>
                            <Border Style="{StaticResource ValuePill}">
                                <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="11.5" Foreground="#CFD9EA"/>
                            </Border>

                            <Button Grid.Column="3" Content="&#x2191;" Tag="{Binding}" Click="MoveUp_Click"
                                    Style="{StaticResource MiniBtn}" ToolTip="上移"/>
                            <Button Grid.Column="3" Content="&#x2193;" Tag="{Binding}" Click="MoveDown_Click"
                                    Style="{StaticResource MiniBtn}" ToolTip="下移"/>
                            <Button Grid.Column="3" Content="&#x2715;" Tag="{Binding}" Click="RemoveCard_Click"
                                    Style="{StaticResource MiniBtn}" ToolTip="移除"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 音频链用紫色，视觉上一眼区分两条流 -->
                <DataTrigger Binding="{Binding Instance.Definition.Scope}" Value="audio">
                    <Setter TargetName="Accent" Property="Background" Value="#A855F7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Conditional">
                    <Setter TargetName="Accent" Property="Background" Value="#FBBF24"/>
                    <Setter TargetName="StateTag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateTag" Property="Background" Value="#33290F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Disabled">
                    <Setter TargetName="Accent" Property="Background" Value="#39445A"/>
                    <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="StateTag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateTag" Property="Background" Value="#2A2020"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="#F87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Hidden">
                    <Setter TargetName="Accent" Property="Background" Value="#39445A"/>
                    <Setter TargetName="Card" Property="Opacity" Value="0.42"/>
                    <Setter TargetName="StateTag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StateTag" Property="Background" Value="#232833"/>
                    <Setter TargetName="StateLabel" Property="Foreground" Value="#7D8DA6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== 模块库条目 ===== -->
        <Style x:Key="LibButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#121720" CornerRadius="7" Padding="9,6" Margin="0,0,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2331"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibTemplate" DataType="{x:Type local:LibraryItemVm}">
            <Button Style="{StaticResource LibButton}" Tag="{Binding}" Click="LibraryItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5" Background="#1A2130"
                            VerticalAlignment="Center">
                        <Path Data="{Binding IconGeometry}" Stroke="#7D8DA6" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="#DFE6F2"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#5D6B82"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="LibState" Grid.Column="2" Text="{Binding StateText}" FontSize="9.5"
                               VerticalAlignment="Center" Foreground="#4D5A70"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Conditional">
                    <Setter TargetName="LibState" Property="Foreground" Value="#FBBF24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Disabled">
                    <Setter TargetName="LibState" Property="Foreground" Value="#F87171"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!-- ===== 深色滑块 ===== -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#1B2330" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#38BDF8"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="14" Height="14" Fill="#38BDF8" Opacity="0.2"/>
                                                    <Ellipse Width="9" Height="9" Fill="#E8F4FF"
                                                             Stroke="#38BDF8" StrokeThickness="1.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 预设值小按钮 ===== -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#93A1B8"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#141B26" BorderBrush="#28303F" BorderThickness="1"
                                CornerRadius="6" Padding="8,3" Margin="0,0,6,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F2A3C"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3A5A8C"/>
                                <Setter Property="Foreground" Value="#CFE0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 参数编辑器（与宿主无关：这里是右侧面板的容器，将来也能塞进卡片） ===== -->
        <DataTemplate x:Key="ControlTemplate" DataType="{x:Type local:ControlVm}">
            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#93A1B8"
                               VerticalAlignment="Center"/>

                    <!-- 数值：可手动输入。滑块拖不准大范围的值，必须能直接敲。 -->
                    <TextBox x:Name="NumInput" DockPanel.Dock="Right" Width="72" Height="23"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             LostFocus="NumericBox_LostFocus"
                             Background="#0D1219" BorderBrush="#28303F" BorderThickness="1"
                             Foreground="#8FD8FF" FontFamily="Consolas" FontSize="11.5"
                             Padding="6,1" HorizontalContentAlignment="Right"
                             CaretBrush="#8FD8FF" ToolTip="{Binding RangeHint}"/>

                    <!-- 非数值：只读显示 -->
                    <TextBlock x:Name="ValueText" Text="{Binding Value}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11.5" Foreground="#8FD8FF"/>
                </DockPanel>

                <Slider x:Name="NumSlider" Visibility="Collapsed" Style="{DynamicResource DarkSlider}"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding DoubleValue, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        SmallChange="1" LargeChange="5"/>

                <ComboBox x:Name="EnumCombo" Visibility="Collapsed"
                          Style="{DynamicResource DarkCombo}" Height="28"
                          ItemsSource="{Binding Options}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Value, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="#E8EDF6"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox x:Name="TextInput" Visibility="Collapsed" Height="28"
                         Background="#0D1219" BorderBrush="#28303F" BorderThickness="1"
                         Foreground="#CFD9EA" FontFamily="Consolas" FontSize="12"
                         Padding="8,4" CaretBrush="#8FD8FF"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ItemsControl x:Name="PresetList" ItemsSource="{Binding Presets}" Margin="0,7,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding}" Click="Preset_Click"
                                    Style="{DynamicResource ChipButton}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                    <Setter TargetName="NumSlider" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NumInput" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNumeric}" Value="False">
                    <Setter TargetName="NumInput" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ValueText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ParamType}" Value="enum">
                    <Setter TargetName="EnumCombo" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NumSlider" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ParamType}" Value="string">
                    <Setter TargetName="TextInput" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NumSlider" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPresets}" Value="False">
                    <Setter TargetName="PresetList" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== 深色下拉框（必须自定义模板，否则是系统白底） ===== -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EDF6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="#171D27" BorderBrush="#28303F"
                                    BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              TextElement.Foreground="#E8EDF6"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M 0,0 L 4,4 L 8,0" Stroke="#5D6B82" StrokeThickness="1.4"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#171D27" BorderBrush="#28303F" BorderThickness="1"
                                        CornerRadius="6" Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4557"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="Foreground" Value="#E8EDF6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#233045"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#0A0C10">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="104"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Border Grid.Row="0" Background="#0D1016" BorderBrush="#1D2431" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#2F5CE0">
                        <Path Data="M 5,4 L 11,7.5 L 5,11 Z" Fill="#FFFFFF"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FFmpeg Studio" FontSize="13" FontWeight="SemiBold" Foreground="#E8EDF6"/>
                        <TextBlock x:Name="CapText" Text="" FontSize="9.5" Foreground="#5D6B82"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#5D6B82"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="保存方案" Click="SavePreset_Click" Style="{StaticResource ChipButton}"
                            Margin="0,0,6,0" Padding="9,4"/>
                    <Button Content="打开方案" Click="LoadPreset_Click" Style="{StaticResource ChipButton}"
                            Margin="0,0,10,0" Padding="9,4"/>
                    <Button Content="{Binding RunButtonText}" Click="RunQueue_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <!-- 左：任务队列 -->
            <Border Grid.Column="0" Background="#0E1117" BorderBrush="#1D2431" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,10,12,8">
                        <DockPanel>
                            <TextBlock Text="任务队列" FontSize="10" Foreground="#5D6B82"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Parallelism, StringFormat=并行 {0}}"
                                       FontSize="9.5" Foreground="#4D5A70" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Button Content="＋ 添加文件 / 拖入" Click="AddFiles_Click"
                                Style="{StaticResource ChipButton}" Margin="0,7,0,0"
                                HorizontalContentAlignment="Center" Padding="0,5"/>
                        <ComboBox Margin="0,7,0,0" Height="26" Style="{StaticResource DarkCombo}"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding Parallelism, Mode=TwoWay}">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                        <ItemsControl ItemsSource="{Binding Jobs}" ItemTemplate="{StaticResource JobTemplate}"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#1D2431" BorderThickness="0,1,0,0" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="输出目录" FontSize="10" Foreground="#5D6B82"/>
                            <DockPanel Margin="0,5,0,0">
                                <Button DockPanel.Dock="Right" Content="..." Click="PickOutputDir_Click"
                                        Style="{StaticResource ChipButton}" Width="30" Margin="6,0,0,0"
                                        Padding="0,3" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="{Binding OutputDirectoryDisplay}" FontSize="10"
                                           Foreground="#93A1B8" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding OutputDirectoryDisplay}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 中：双链 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：编码器 / 容器 / 媒体模式 -->
                <Border Grid.Row="0" BorderBrush="#1D2431" BorderThickness="0,0,0,1" Padding="14,9">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="视频" FontSize="11" Foreground="#5D6B82" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="EncoderCombo" Style="{StaticResource DarkCombo}"
                                      Width="136" Margin="6,0,0,0"
                                      ItemsSource="{Binding EncoderChoices}"
                                      SelectedItem="{Binding VideoEncoder, Mode=TwoWay}"/>

                            <TextBlock Grid.Column="2" Text="音频" FontSize="11" Foreground="#5D6B82"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <ComboBox Grid.Column="3" x:Name="AudioCombo" Style="{StaticResource DarkCombo}"
                                      Width="116" Margin="6,0,0,0"
                                      ItemsSource="{Binding AudioEncoderChoices}"
                                      SelectedItem="{Binding AudioEncoder, Mode=TwoWay}"/>

                            <TextBlock Grid.Column="4" Text="容器" FontSize="11" Foreground="#5D6B82"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <ComboBox Grid.Column="5" x:Name="ContainerCombo" Style="{StaticResource DarkCombo}"
                                      Width="78" Margin="6,0,0,0"
                                      ItemsSource="{Binding ContainerChoices}"
                                      SelectedItem="{Binding Container, Mode=TwoWay}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IncludesVideo, Mode=TwoWay}">
                                <TextBlock Text="包含视频流" FontSize="10.5" Foreground="#93A1B8"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IncludesAudio, Mode=TwoWay}"
                                          Margin="18,0,0,0">
                                <TextBlock Text="包含音频流" FontSize="10.5" Foreground="#93A1B8"/>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse Width="7" Height="7" Fill="#22D3EE" VerticalAlignment="Center"/>
                            <TextBlock Text="视频流" FontSize="11.5" FontWeight="SemiBold" Foreground="#7CE7F7" Margin="8,0,0,0"/>
                            <TextBlock Text="v:0 · 3840×2160 · 30fps" FontFamily="Consolas" FontSize="10"
                                       Foreground="#5D6B82" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding VideoChain}" ItemTemplate="{StaticResource CardTemplate}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,7">
                            <Ellipse Width="7" Height="7" Fill="#B388FF" VerticalAlignment="Center"/>
                            <TextBlock Text="音频流" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBB2FF" Margin="8,0,0,0"/>
                            <TextBlock Text="a:0 · 48 kHz · stereo" FontFamily="Consolas" FontSize="10"
                                       Foreground="#5D6B82" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding AudioChain}" ItemTemplate="{StaticResource CardTemplate}"/>

                        <Border Height="30" CornerRadius="8" BorderBrush="#333D4F" BorderThickness="1"
                                Margin="0,8,0,0" Opacity="0.6">
                            <TextBlock Text="从右侧模块库点击添加" FontSize="10.5" Foreground="#4D5A70"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 输出节点 -->
                <Border Grid.Row="2" Padding="14,4,14,12">
                    <Border Background="#151C28" CornerRadius="10" BorderBrush="#2A3040" BorderThickness="1" Padding="13,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                    Background="#1A2333" BorderBrush="#2C3A52" BorderThickness="1">
                                <Path Data="M 12,3 L 20,7.5 L 20,16.5 L 12,21 L 4,16.5 L 4,7.5 Z M 4,7.5 L 12,12 L 20,7.5 M 12,12 L 12,21"
                                      Stroke="#9DB8E8" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="输出封装" FontSize="12.5" FontWeight="SemiBold" Foreground="#E8EDF6"/>
                                    <Border Background="#12291F" CornerRadius="4" Padding="5,0" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding Container}" FontSize="9.5" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="D:\Export\{name}.mp4" FontFamily="Consolas" FontSize="10"
                                           Foreground="#5D6B82" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- 右：模块库 / 参数编辑 -->
            <Border Grid.Column="2" Background="#0E1117" BorderBrush="#1D2431" BorderThickness="1,0,0,0">
                <Grid>
                    <!-- 模块库 -->
                    <Grid Visibility="{Binding NotEditing, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="参数模块库" FontSize="10" Foreground="#5D6B82" Margin="12,10,0,8"/>

                        <Border Grid.Row="1" Margin="12,0,12,10" Padding="8,6" CornerRadius="7"
                                Background="#101A26" BorderBrush="#22344D" BorderThickness="1">
                            <TextBlock FontSize="10" Foreground="#8FB6FF" TextWrapping="Wrap"
                                       Text="已按当前编码器过滤：不兼容的模块不出现在下方，冲突的模块标为「已停用」。"/>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                            <ItemsControl ItemsSource="{Binding LibraryItems}" ItemTemplate="{StaticResource LibTemplate}"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 参数编辑（点卡片后进入） -->
                    <Grid Visibility="{Binding Editing, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="11,8" BorderBrush="#1D2431" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#x2190; 模块库" Click="BackToLibrary_Click" Style="{DynamicResource ChipButton}"/>
                                <TextBlock Text="{Binding SelectedDefinition.Title}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#E8EDF6"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDefinition.Doc}" TextWrapping="Wrap"
                                           FontSize="11" Foreground="#93A1B8" LineHeight="19" Margin="0,0,0,14"/>
                                <Border Height="1" Background="#1D2431" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding EditorControls}"
                                              ItemTemplate="{StaticResource ControlTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部命令 ===== -->
        <Border Grid.Row="2" Background="#0E1117" BorderBrush="#1D2431" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="生成的命令" FontSize="10" Foreground="#5D6B82"/>
                    <Border Background="#12291F" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                        <TextBlock Text="实时同步" FontSize="9" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Background="#080B10" BorderBrush="#1D2431" BorderThickness="1"
                        CornerRadius="8" Padding="11,7">
                    <TextBlock Text="{Binding CommandText}" FontFamily="Consolas"
                               FontSize="11.5" Foreground="#C9D5E8" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
